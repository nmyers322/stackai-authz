# Copy to .env. Leave these commented to run against the in-memory demo store.

# Supabase project URL — used only to fetch JWKS and set the JWT issuer.
# APP_SUPABASE_URL=https://<project-ref>.supabase.co

# Direct Postgres as the postgres role, via the IPv4 session pooler.
# Free-tier db.<ref>.supabase.co is IPv6-only; the pooler is the IPv4 path.
# APP_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# APP_JWT_AUDIENCE=authenticated

# Local lab UI at /debug. Never enable in Compose or production.
APP_DEBUG=false
